# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# The Flutter SDK itself lives outside this repo (E:\flutter) -- never
# vendor/commit an SDK checkout here again (see the corrupted
# flutter_windows_3.41.9-stable incident it caused).
/flutter/
/flutter_windows*/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing -- never commit the real keystore or its
# passwords. CI decodes these from GitHub secrets at build time instead
# (see .github/workflows/build-release.yml and android/KEYSTORE.md).
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# iOS release signing -- same reasoning, decoded from secrets in CI.
/ios/certs/
*.p12
*.mobileprovision

# Firebase (mobile push) config -- project-identifying but not secret in
# the strict sense; still never committed, decoded from secrets in CI
# same as the signing files above (see PUSH_NOTIFICATIONS.md).
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist

# Vendored, patched flutter_webrtc (Windows mic EQ -- see
# tool/vendor_flutter_webrtc.ps1 and native/flutter_webrtc_eq_patch/).
# This is a full local copy of the upstream package plus its bundled
# libwebrtc binaries (~30MB) -- a rebuildable local artifact, not
# something to commit. The actual patch is tracked separately.
/third_party/flutter_webrtc/
