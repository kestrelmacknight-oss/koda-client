+  static bool get _supportsMicEqGains => !kIsWeb && WebRTC.platformIsWindows;
+
+  /// Sets the 3-band (bass/mid/treble) EQ applied to the outgoing mic
+  /// signal before it's encoded and published -- see
+  /// windows/audio_eq_processor.h for the actual DSP. Gains are in dB,
+  /// 0.0 for all three is a no-op/flat pass-through.
+  ///
+  /// Windows only -- this is a Koda-specific patch on top of upstream
+  /// flutter_webrtc, not a real upstream feature (see rtc_audio_processing.h's
+  /// CustomProcessing, which upstream never wires to anything). On every
+  /// other platform this is a no-op that completes normally, so it's
+  /// always safe to call from cross-platform code.
+  static Future<void> setMicEqGains({
+    required double bass,
+    required double mid,
+    required double treble,
+  }) async {
+    if (!_supportsMicEqGains) return;
+
+    try {
+      await WebRTC.invokeMethod('setMicEqGains', <String, dynamic>{
+        'bass': bass,
+        'mid': mid,
+        'treble': treble,
+      });
+    } on PlatformException catch (e) {
+      throw 'Unable to set mic EQ gains: ${e.message}';
+    }
+  }
+
+  /// Sets a broadband preamp/boost gain (dB, roughly 0..20) applied to
+  /// the outgoing mic signal before the EQ bands above -- see
+  /// windows/audio_eq_processor.h's SetBoostDb. 0.0 is a no-op.
+  ///
+  /// Windows only -- same Koda-specific patch as [setMicEqGains]. No-op
+  /// elsewhere.
+  static Future<void> setMicBoost(double boostDb) async {
+    if (!_supportsMicEqGains) return;
+
+    try {
+      await WebRTC.invokeMethod('setMicBoost', <String, dynamic>{
+        'boost': boostDb,
+      });
+    } on PlatformException catch (e) {
+      throw 'Unable to set mic boost: ${e.message}';
+    }
+  }
 }
