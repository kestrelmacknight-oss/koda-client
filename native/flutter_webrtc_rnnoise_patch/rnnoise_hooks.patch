diff --git a/lib/src/helper.dart b/lib/src/helper.dart
index 9f22f78..3b26fc0 100644
--- a/lib/src/helper.dart
+++ b/lib/src/helper.dart
@@ -173,6 +173,12 @@ class Helper {
   static Future<void> setMicBoost(double boostDb) =>
       NativeAudioManagement.setMicBoost(boostDb);
 
+  /// Enable/disable RNNoise-based deep noise suppression on the outgoing
+  /// mic signal -- see [NativeAudioManagement.setDeepNoiseSuppression].
+  /// Windows only, a no-op elsewhere.
+  static Future<void> setDeepNoiseSuppression(bool enabled) =>
