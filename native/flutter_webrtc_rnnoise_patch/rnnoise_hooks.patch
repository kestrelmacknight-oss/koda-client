diff --git a/lib/src/native/audio_management.dart b/lib/src/native/audio_management.dart
index 5397bdb..102ec0f 100644
--- a/lib/src/native/audio_management.dart
+++ b/lib/src/native/audio_management.dart
@@ -294,4 +294,26 @@ class NativeAudioManagement {
       throw 'Unable to set mic boost: ${e.message}';
     }
   }
+
+  /// Enables/disables RNNoise-based real-time neural noise suppression
+  /// on the outgoing mic signal, applied before the EQ bands above --
+  /// see windows/audio_noise_suppressor.h. Mutually exclusive with
+  /// WebRTC's own built-in noise suppression at the Dart settings layer
+  /// (see VoiceSettings.deepNoiseSuppression in core/providers.dart) --
+  /// this call itself doesn't enforce that, it just flips this one
+  /// processor on/off.
+  ///
+  /// Windows only -- same Koda-specific patch shape as [setMicEqGains]/
+  /// [setMicBoost]. No-op elsewhere.
+  static Future<void> setDeepNoiseSuppression(bool enabled) async {
+    if (!_supportsMicEqGains) return;
+
+    try {
+      await WebRTC.invokeMethod('setDeepNoiseSuppression', <String, dynamic>{
+        'enabled': enabled,
+      });
+    } on PlatformException catch (e) {
+      throw 'Unable to set deep noise suppression: ${e.message}';
+    }
+  }
 }
